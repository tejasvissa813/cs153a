XIntc sys_intc;
XGpio EncoderGpio;
XGpio ButtonGpio;
XTmrCtr sys_tmrctr;

enum States {
	R,
	CW1,
	CW0,
	CW2,
	CCW2,
	CCW0,
	CCW1
};
volatile int enable = 1;
enum States fsm = R;
float freq = 0;

void BSP_init(void){
	XIntc_Initialize(&sys_intc, XPAR_MICROBLAZE_0_AXI_INTC_DEVICE_ID);

	XIntc_Connect(&sys_intc, XPAR_MICROBLAZE_0_AXI_INTC_ENCODER_IP2INTC_IRPT_INTR,
					(XInterruptHandler) TwistHandler, &EncoderGpio);
	XIntc_Connect(&sys_intc, XPAR_MICROBLAZE_0_AXI_INTC_AXI_GPIO_BTN_IP2INTC_IRPT_INTR,
					(XInterruptHandler) GpioHandler, &ButtonGpio);
	XIntc_Connect(&sys_intc, XPAR_MICROBLAZE_0_AXI_INTC_AXI_TIMER_0_INTERRUPT_INTR,
						(XInterruptHandler) TimerHandler, &sys_tmrctr);

	XIntc_Start(&sys_intc, XIN_REAL_MODE);

	XIntc_Enable(&sys_intc, XPAR_MICROBLAZE_0_AXI_INTC_ENCODER_IP2INTC_IRPT_INTR);
	XIntc_Enable(&sys_intc, XPAR_MICROBLAZE_0_AXI_INTC_AXI_GPIO_BTN_IP2INTC_IRPT_INTR);
	XIntc_Enable(&sys_intc, XPAR_MICROBLAZE_0_AXI_INTC_AXI_TIMER_0_INTERRUPT_INTR);

	XGpio_Initialize(&EncoderGpio, XPAR_GPIO_2_DEVICE_ID);
	XGpio_InterruptEnable(&EncoderGpio, 1);
	XGpio_InterruptGlobalEnable(&EncoderGpio);

	XGpio_Initialize(&ButtonGpio, XPAR_AXI_GPIO_BTN_DEVICE_ID);
	XGpio_InterruptEnable(&ButtonGpio, 1);
	XGpio_InterruptGlobalEnable(&ButtonGpio);

	XTmrCtr_Initialize(&sys_tmrctr, XPAR_AXI_TIMER_0_DEVICE_ID);
	XTmrCtr_SetOptions(&sys_tmrctr, 0, XTC_INT_MODE_OPTION | XTC_AUTO_RELOAD_OPTION);
	XTmrCtr_SetResetValue(&sys_tmrctr, 0, 0xFFFFFFFF - 100000000);
	XTmrCtr_Start(&sys_tmrctr, 0);

	microblaze_register_handler(
			(XInterruptHandler) XIntc_DeviceInterruptHandler,
			(void*) XPAR_MICROBLAZE_0_AXI_INTC_DEVICE_ID);

	microblaze_enable_interrupts();
	xil_printf("Interrupts enabled!\r\n");


}

void GpioHandler(void *CallbackRef) {
	// Increment A counter
	XGpio *GpioPtr = (XGpio *)CallbackRef;
	unsigned int buttonVal = XGpio_DiscreteRead(&ButtonGpio, 1);
	if(buttonVal == 1){
		xil_printf("BTN 1");
	}
	else if(buttonVal == 2){
		QActive_postISR((QActive *)&AO_Lab2A, PREV);
	}
	else if(buttonVal == 4){
		QActive_postISR((QActive *)&AO_Lab2A, NEXT);
	}
	else if(buttonVal == 8){
		xil_printf("BTN 4");
	}
	else if(buttonVal == 16){
		xil_printf("BTN 5");
	}
	XGpio_InterruptClear(GpioPtr, 1);
}

void TwistHandler(void *CallbackRef) {
	//XGpio_DiscreteRead( &twist_Gpio, 1);

	XGpio *GpioPtr = (XGpio *)CallbackRef;
	xil_printf("STATE: %d\r\n", fsm);

	unsigned int encoderVal = XGpio_DiscreteRead(&EncoderGpio, 1);
	if(encoderVal > 3){
		enable = 1 - enable;
		//QActive_postISR((QActive *)&AO_Lab2A, ENCODER_CLICK);
		XGpio_InterruptClear(GpioPtr, 1);
		return;
	}

	int bit0 = 1 & encoderVal;
	int bit1 = (2 & encoderVal) >> 1;

	if(enable){
		switch(fsm){
		case R:
			if(bit0 == 0) fsm = CW1;
			else if(bit1 == 0) fsm = CCW2;
			//else xil_printf("ERROR");
			break;
		case CW1:
			if(bit0 == 1) fsm = R;
			else if(bit1 == 0) fsm = CW0;
			//else xil_printf("ERROR");
			break;
		case CW0:
			if(bit0 == 1) fsm = CW2;
			else if(bit1 == 1) fsm = CW1;
			//else xil_printf("ERROR");
			break;
		case CW2:
			if(bit0 == 0) fsm = CW0;
			else if(bit1 == 1) {
				QActive_postISR((QActive *)&AO_Lab2A, ENCODER_UP);
			}
			//else xil_printf("ERROR");
			break;
		case CCW2:
			if(bit0 == 0) fsm = CCW0;
			else if(bit1 == 1) fsm = R;
			//else xil_printf("ERROR");
			break;
		case CCW0:
			if(bit0 == 1) fsm = CCW2;
			else if(bit1 == 1) fsm = CCW1;
			//else xil_printf("ERROR");
			break;
		case CCW1:
			if(bit0 == 1){
				xil_printf("down");
				QActive_postISR((QActive *)&AO_Lab2A, ENCODER_DOWN);
			}
			else if(bit1 == 0) fsm = CCW0;
			//else xil_printf("ERROR");
			break;
		}
	}
	XGpio_InterruptClear(GpioPtr, 1);

}

void TimerHandler(){
	Xuint32 ControlStatusReg;
	ControlStatusReg = XTimerCtr_ReadReg(sys_tmrctr.BaseAddress, 0, XTC_TCSR_OFFSET);

	//QActive_postISR((QActive *)&AO_Lab2A, TICK_SIG);
	QActive_postISR((QActive *)&AO_Lab2A, TICK_SIG);

	XTmrCtr_WriteReg(sys_tmrctr.BaseAddress, 0, XTC_TCSR_OFFSET,
				ControlStatusReg |XTC_CSR_INT_OCCURED_MASK);
}


