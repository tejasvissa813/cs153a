typedef struct {
    unsigned char r, g, b;
} RGBColor;

RGBColor floatToJetColor(float value, float minVal, float maxVal) {
    RGBColor color = {0, 0, 0};

    if (value < minVal || value > maxVal) {
        return color; // Return black for out-of-range values
    }

    float scaledValue = (value - minVal) / (maxVal - minVal);

    if (scaledValue < 0.125) {
        color.b = 255 * (0.5 + 4 * scaledValue);
    } else if (scaledValue < 0.375) {
        color.b = 255;
        color.g = 255 * (4 * scaledValue - 1);
    } else if (scaledValue < 0.625) {
        color.g = 255;
        color.r = 255 * (4 * scaledValue - 3);
    } else if (scaledValue < 0.875) {
        color.r = 255;
        color.b = 255 * (7 - 4 * scaledValue);
    } else {
        color.r = 255 * (9 - 4 * scaledValue);
    }

    return color;
}


