void Lab2A_ctor(void)  {
	Lab2A *me = &AO_Lab2A;
	QActive_ctor(&me->super, (QStateHandler)&Lab2A_initial);
	AO_Lab2A.A4 = 440;
	AO_Lab2A.note = 'A';
	AO_Lab2A.encode = 1;
//	AO_Lab2A.text = {"B", "T", "N", "_", "6", "\0"};
}


QState Lab2A_initial(Lab2A *me) {
	xil_printf("\n\rInitialization");
	lcd_setup();
    return Q_TRAN(&Lab2A_on);
}

QState Lab2A_on(Lab2A *me) {
	switch (Q_SIG(me)) {
		case Q_ENTRY_SIG: {
			xil_printf("\n\rOn");
		}
			
		case Q_INIT_SIG: {
			return Q_TRAN(&Lab2A_stateMain);
		}

		case TICK_SIG: {
			if(AO_Lab2A.encode == 0) AO_Lab2A.encode = 1;
			return Q_HANDLED();
		}

		case ENCODER_DOWN: {
			if(AO_Lab2A.encode && AO_Lab2A.A4 > 420){
				AO_Lab2A.encode = 0;
				AO_Lab2A.A4--;
			}
			return Q_HANDLED();
		}

		case ENCODER_UP: {
			if(AO_Lab2A.encode && AO_Lab2A.A4 < 460){
				AO_Lab2A.encode = 0;
				AO_Lab2A.A4++;
			}
			return Q_HANDLED();
		}

//		case ENCODER_CLICK: {
//			xil_printf("%d\n\r", AO_Lab2A.A4);
//			return Q_HANDLED();
//		}
		//add cases for each of the Button Signals
		//mAKE SURE TO RESET THE SECONDS VALUE WHEN ANY INPUT IS TRIGGERED
	}
	
	return Q_SUPER(&QHsm_top);
}


