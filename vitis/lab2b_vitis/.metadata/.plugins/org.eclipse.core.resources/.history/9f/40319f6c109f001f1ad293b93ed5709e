void GpioHandler(void *CallbackRef) {
	// Increment A counter
	XGpio *GpioPtr = (XGpio *)CallbackRef;
	unsigned int buttonVal = XGpio_DiscreteRead(&ButtonGpio, 1);
	if(buttonVal == 1){
		QActive_postISR((QActive *)&AO_Lab2A, BTN_1);
//		xil_printf("BTN 1");
	}
	else if(buttonVal == 2){
		QActive_postISR((QActive *)&AO_Lab2A, BTN_2);
//		xil_printf("BTN 2");
	}
	else if(buttonVal == 4){
		QActive_postISR((QActive *)&AO_Lab2A, BTN_3);
//		xil_printf("BTN 3");
	}
	else if(buttonVal == 8){
		QActive_postISR((QActive *)&AO_Lab2A, BTN_4);
//		xil_printf("BTN 4");
	}
	else if(buttonVal == 16){
		QActive_postISR((QActive *)&AO_Lab2A, BTN_5);
//		xil_printf("BTN 5");
	}
	XGpio_InterruptClear(GpioPtr, 1);
}

void TwistHandler(void *CallbackRef) {

	//XGpio_DiscreteRead( &twist_Gpio, 1);

	XGpio *GpioPtr = (XGpio *)CallbackRef;
	int change = -1;

	unsigned int val = XGpio_DiscreteRead(&EncoderGpio, 1);
	xil_printf("%d",val);
//	XGpio_InterruptClear(GpioPtr, 1);
//	return;
	time = 0;
	if(!encoder){
		if (val == 7){
			QActive_postISR((QActive *)&AO_Lab2A, ENCODER_CLICK);
			XGpio_InterruptClear(GpioPtr, 1);
			return;
		}
		encoder = 1;
	}
	else{
		XGpio_InterruptClear(GpioPtr, 1);
		return;
	}
	xil_printf("      xfsm%d     ", xfsm);
	switch(xfsm){
	case 0:{
		if (val == 1){
//			xil_printf("      o_fire     ");
			change = 2;
			QActive_postISR((QActive *)&AO_Lab2A, ENCODER_UP);
		}
		else if (val == 2){
			change = 4;
			QActive_postISR((QActive *)&AO_Lab2A, ENCODER_DOWN);
		}
		break;
	}
	case 1:{
//		xil_printf("      shpuld_fire     ");
		if (val == 1){
//			xil_printf("      c_fire     ");
			change = 2;
			QActive_postISR((QActive *)&AO_Lab2A, ENCODER_UP);

		}
		break;
	}
	case 2:{
//		xil_printf("      HERE!     ");
		if (val == 2 || val == 3){
//			xil_printf("      HERE!     ");
			change = 1;
		}
		break;
	}
	case 3:{
		if (val == 2){
			change = 4;
//			xil_printf("      c_fire     ");
			QActive_postISR((QActive *)&AO_Lab2A, ENCODER_DOWN);

		}
		break;
	}
	case 4:{
		if (val == 0 || val == 1){
			change = 3;
		}
		break;
	}
	}
	if(change != -1)xfsm = change;

	last_input = 0;
	XGpio_InterruptClear(GpioPtr, 1);
	return;
}

void TimerHandler(){
	Xuint32 ControlStatusReg;
	ControlStatusReg = XTimerCtr_ReadReg(sys_tmrctr.BaseAddress, 0, XTC_TCSR_OFFSET);
//	xil_printf("      clear up     ");

	QActive_postISR((QActive *)&AO_Lab2A, TICK_SIG);

	XTmrCtr_WriteReg(sys_tmrctr.BaseAddress, 0, XTC_TCSR_OFFSET,
				ControlStatusReg |XTC_CSR_INT_OCCURED_MASK);
}

void TimerHandler_s(){
	Xuint32 ControlStatusReg;
	ControlStatusReg = XTimerCtr_ReadReg(sys_tmrctr_s.BaseAddress, 0, XTC_TCSR_OFFSET);
	if(time != -1){
		time ++;
		if (time > 3000){
			QActive_postISR((QActive *)&AO_Lab2A, TICK_SIG);
			time = -1;
		}else{
			last ++;
			if (last > 330){
				QActive_postISR((QActive *)&AO_Lab2A, VOL_SIG);
				last = 0;
			}
		}
	}

	if(encoder){
		short_time ++;
		if (short_time >=400){
			short_time = 0;
			encoder = 0;
		}
	}

	if(last_input != -1){
		last_input++;

		if (last_input > 600){

			xfsm = 0;
			last_input = -1;
		}
	}
	XTmrCtr_WriteReg(sys_tmrctr_s.BaseAddress, 0, XTC_TCSR_OFFSET,
				ControlStatusReg |XTC_CSR_INT_OCCURED_MASK);
}


